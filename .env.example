# --- Database ---
# For Docker Compose (db service), use the internal host "db"
DATABASE_URL="postgresql://takween:changeme@db:5432/takween?schema=public"
# For local dev against a local Postgres container:
# DATABASE_URL="postgresql://takween:changeme@127.0.0.1:5432/takween?schema=public"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
# WARNING: the app refuses to boot/seed when this equals the placeholder.
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- Runtime ---
# Only set AUTH_TRUST_HOST=true when you are behind a non-HTTPS proxy or
# hosting the app on an untrusted host. Do not enable in production compose.
AUTH_TRUST_HOST="false"
NODE_ENV="production"

# --- Bootstrap admin (required at seed time) ---
# Generate the password with: openssl rand -base64 24
ADMIN_EMAIL="admin@takween.com"
ADMIN_PASSWORD="generate-a-strong-random-password"

# --- Startup behaviour ---
RUN_MIGRATIONS="true"
SEED_ON_START="false"

# --- Compose only ---
POSTGRES_PASSWORD="changeme"

# --- File uploads (mounted volume in Compose) ---
UPLOAD_DIR="/app/data"

# --- SMTP / Email (optional, recommended) ---
# When set, these take precedence over DB-stored SMTP settings.
# The admin settings page will show these as read-only.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-email-password"
MAIL_FROM="no-reply@takween.com"